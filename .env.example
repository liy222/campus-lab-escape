# Copy this example to the project root .env for scripts.dev.
# Existing process environment variables take priority. No shell expansion.
# SQLite is used by the current backend candidate. AI settings describe the
# frozen contract; a configured key does not mean a real provider is accepted.
APP_ENV=local
AI_PROVIDER=mock
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
# Optional user-selected DeepSeek configuration (approved total paid budget: CNY 10):
# AI_PROVIDER=deepseek
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
# MODEL_API_KEY=your-local-key
AI_MAX_MODEL_CALLS=3
AI_MAX_READ_TOOLS=5
AI_TURN_TIMEOUT_SECONDS=45
AI_PROPOSAL_TTL_SECONDS=120
SQLITE_PATH=./data/game.sqlite
